# --------------------------------------------------------------------------
# TC-ATLAS env-overlay builder — Cloud Run Job container
# --------------------------------------------------------------------------
# Builds global PNGs (200-850 hPa shear, 700-400 hPa RH, OISST SST) from
# the latest GFS analysis + NOAA OISST and uploads them to GCS for the
# RT Monitor's Environmental Analysis overlay menu.
#
# Build:   gcloud builds submit --tag gcr.io/$PROJECT/tc-atlas-env-job -f Dockerfile.env .
# Deploy:  ./deploy_env_job.sh
# --------------------------------------------------------------------------

FROM python:3.11-slim

# eccodes + libgeos for cfgrib / xarray; libhdf5 + netCDF for OISST .nc
# DEBIAN_FRONTEND=noninteractive silences debconf's fruitless search for
# a usable TTY frontend in Cloud Build (Dialog → Readline → Teletype → Noninteractive).
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libhdf5-dev \
        libeccodes-dev \
        libeccodes-data \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libgeos-dev \
        libproj-dev \
        proj-data \
        proj-bin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# A leaner requirements set than the main API. We only need numerics +
# matplotlib + cfgrib + GCS upload. `pandas` is only used by the
# seasonal-diagnostics script (read/write parquet + DataFrame ops) but
# we install it here so we can keep all three Run Jobs on one image.
RUN pip install --no-cache-dir \
        numpy \
        scipy \
        pandas \
        pyarrow \
        matplotlib \
        Pillow \
        xarray \
        cartopy \
        cfgrib \
        eccodes \
        netCDF4 \
        h5netcdf \
        requests \
        google-cloud-storage \
        numba \
        tcpypi

COPY build_env_overlays.py .
# Physics core for the MPI / ventilation-index / vPI layers. The
# Dockerfile COPYs each module EXPLICITLY, so a new backend file that
# isn't listed here imports fine locally and then dies in the container —
# that exact omission once took the API down with a ModuleNotFoundError.
COPY potential_intensity.py .
COPY build_subseasonal_overlays.py .
COPY build_oisst_history.py .
COPY build_seasonal_diagnostics.py .

# Seed JSON for the daily index refresh. The refresh_indices() function
# in build_subseasonal_overlays.py reads this as the baseline when the
# GCS-uploaded copy doesn't exist yet (first run), then overwrites it
# in GCS each day with fresh BOM RMM / APCC BSISO / NOAA PSL ROMI data.
COPY data/subseasonal_phases.json ./data/subseasonal_phases.json

# Cloud Run Jobs invoke the container; there's no $PORT to bind. The
# default ENTRYPOINT just runs the env-overlay script once and exits.
# Sibling jobs override the command at job-create time so they share
# the image, dependencies, and base-layer pull cost:
#   tc-atlas-subseasonal-job → python build_subseasonal_overlays.py
#   tc-atlas-seasonal-job    → python build_seasonal_diagnostics.py
ENTRYPOINT ["python", "build_env_overlays.py"]
