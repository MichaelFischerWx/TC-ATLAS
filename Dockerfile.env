# --------------------------------------------------------------------------
# TC-ATLAS env-overlay builder — Cloud Run Job container
# --------------------------------------------------------------------------
# Builds global PNGs (200-850 hPa shear, 700-400 hPa RH, OISST SST) from
# the latest GFS analysis + NOAA OISST and uploads them to GCS for the
# RT Monitor's Environmental Analysis overlay menu.
#
# Build:   gcloud builds submit --tag gcr.io/$PROJECT/tc-atlas-env-job -f Dockerfile.env .
# Deploy:  ./deploy_env_job.sh
# --------------------------------------------------------------------------

FROM python:3.11-slim

# eccodes + libgeos for cfgrib / xarray; libhdf5 + netCDF for OISST .nc
# DEBIAN_FRONTEND=noninteractive silences debconf's fruitless search for
# a usable TTY frontend in Cloud Build (Dialog → Readline → Teletype → Noninteractive).
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libhdf5-dev \
        libeccodes-dev \
        libeccodes-data \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# A leaner requirements set than the main API. We only need numerics +
# matplotlib + cfgrib + GCS upload.
RUN pip install --no-cache-dir \
        numpy \
        matplotlib \
        Pillow \
        xarray \
        cfgrib \
        eccodes \
        netCDF4 \
        h5netcdf \
        requests \
        google-cloud-storage

COPY build_env_overlays.py .

# Cloud Run Jobs invoke the container; there's no $PORT to bind. The
# default ENTRYPOINT just runs the script once and exits.
ENTRYPOINT ["python", "build_env_overlays.py"]
