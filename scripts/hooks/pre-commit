#!/bin/sh
# Refuse a commit that leaves a shared asset under two ?v= cache tokens
# (scripts/check_version_tokens.sh), a stylesheet font size off the type scale
# (scripts/check_type_scale.sh), an emoji (scripts/check_no_emoji.sh), or a
# hard-coded corner radius or elevation shadow (scripts/check_corner_shadow_tokens.sh). Two tokens for one file means some pages
# keep getting an older copy from the CDN.
#
# Checks the STAGED copies of the pages and loaders, not the working tree,
# which often holds unrelated WIP. Install once per clone with
# scripts/install_hooks.sh; skip a single commit with `git commit --no-verify`.
top=$(git rev-parse --show-toplevel) || exit 0
check="$top/scripts/check_version_tokens.sh"
[ -f "$check" ] || exit 0

# Only a commit that touches a top-level page, script or stylesheet can drift.
git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^[^/]+\.(html|js|css)$' || exit 0

tmp=$(mktemp -d "${TMPDIR:-/tmp}/tc-token-check.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM
git ls-files -z -- ':(glob)*.html' ':(glob)*.js' ':(glob)*.css' | git checkout-index -z --stdin --prefix="$tmp/"
mkdir -p "$tmp/scripts"
cp "$check" "$tmp/scripts/"
if ! out=$(bash "$tmp/scripts/check_version_tokens.sh" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "pre-commit: give each file above ONE fresh ?v= token on every page, or commit with --no-verify." >&2
    exit 1
fi

# Stylesheet font sizes stay on the type scale (scripts/check_type_scale.sh).
scale="$top/scripts/check_type_scale.sh"
if [ -f "$scale" ]; then
    cp "$scale" "$tmp/scripts/"
    if ! out=$(bash "$tmp/scripts/check_type_scale.sh" 2>&1); then
        printf '%s\n' "$out" >&2
        echo "pre-commit: move each size above onto the type scale, or commit with --no-verify." >&2
        exit 1
    fi
fi

# No emoji in the UI (scripts/check_no_emoji.sh).
noemoji="$top/scripts/check_no_emoji.sh"
if [ -f "$noemoji" ]; then
    cp "$noemoji" "$tmp/scripts/"
    if ! out=$(bash "$tmp/scripts/check_no_emoji.sh" 2>&1); then
        printf '%s\n' "$out" >&2
        echo "pre-commit: replace each emoji above with an SVG icon or text (or run scripts/check_no_emoji.sh --fix for the selector), or commit with --no-verify." >&2
        exit 1
    fi
fi

# Corners and elevation shadows use the tokens (scripts/check_corner_shadow_tokens.sh).
corners="$top/scripts/check_corner_shadow_tokens.sh"
if [ -f "$corners" ]; then
    cp "$corners" "$tmp/scripts/"
    if ! out=$(bash "$tmp/scripts/check_corner_shadow_tokens.sh" 2>&1); then
        printf '%s\n' "$out" >&2
        echo "pre-commit: use the --radius-* / --shadow-* tokens for each line above, or commit with --no-verify." >&2
        exit 1
    fi
fi
exit 0
