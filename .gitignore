# Deployment secrets (contains AWS keys — never commit)
deploy.env

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Cache and data files
mergir_cache/
*.log

# Large data (tracked as split files instead)
ibtracs_tracks.json

# pipeline/refresh_ibtracs.py work dirs:
#   data/_ibtracs_cache/      — downloaded source netCDF (~600 MB)
#   data/_ibtracs_smoketest/  — --since-flag sandbox output for diff/inspect
# Both ephemeral; never commit. Underscore prefix marks them as private to
# the pipeline so future data/* additions (like data/indices.json) stay
# trackable without an explicit allow-list.
data/_ibtracs_*/
# build_subseasonal_overlays.py work dirs:
#   data/_olr_cache/             — cached OLR climatology netCDF
#   data/subseasonal_overlays/   — validation PNG outputs (real artifact ships to GCS)
data/_olr_cache/
data/subseasonal_overlays/
# build_oisst_history.py / build_seasonal_diagnostics.py work dirs:
#   data/seasonal/               — local validation copies of OISST seasonal
#     blobs (climatology netCDF, indices JSON/parquet, ACE history, anomaly
#     PNGs, correlation maps). Real artifacts ship to gs://tc-atlas-ir-cache/seasonal/.
data/seasonal/

# Claude Code working state
.claude/
mosaic_out/
_ir2a_dev/
ir2a_proto.html
ir2a_colorrelief.html
_ir2a_dem/
_ir2a_anim
_ir2a_anim_old_fixture/
rt_pack_test.html
mosaic_out2/
ir2a_webgl.html
_ir2a_anim/
ir2a_anim.html

# Local dev artifacts (wrangler state, misc local caches)
.wrangler/
cache/

# Daily-index intermediates (JSON payloads ship to GCS; parquet stays local)
data/*.parquet

# GHOST-RA local dev data (published to cdn.tcatlas.org/ghost-ra/, not to Pages)
ghost-ra/
data/era5_600_monthly/
