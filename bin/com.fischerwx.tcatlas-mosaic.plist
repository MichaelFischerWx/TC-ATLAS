<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fischerwx.tcatlas-mosaic</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mfischer/.tcatlas-mosaic/run_mosaic_local.sh</string>
    </array>
    <!-- Every 10 min on the UTC tens (minutes are the same in local time; DST
         only moves the hour). The Cloud Run backstop fires 7 min after each. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/mfischer/Library/Logs/tcatlas-mosaic.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mfischer/Library/Logs/tcatlas-mosaic.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Same politeness as com.fischerwx.tcatlas-env: yield CPU and disk to
         interactive work without opting into Background throttling (a slow
         pass just hands the frame to the backstop). -->
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
