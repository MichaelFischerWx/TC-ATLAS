# --------------------------------------------------------------------------
# TC-ATLAS PARDIG rain-rate tiles -- Cloud Run Job container
# --------------------------------------------------------------------------
# build_pardig_rain.py polls DeepMind's public PARDIG bucket (anonymous HTTPS),
# turns any new 15-min frames into single-channel map tiles and publishes
# them to R2 (cdn.tcatlas.org/pardig-v1/rain/). Most runs find nothing new and
# exit in a few seconds; a fresh 6-hourly batch (24 frames) takes ~1-2 min.
# Build context is staged by deploy_pardig_job.sh (this file + the script).
# --------------------------------------------------------------------------
FROM python:3.12-slim

RUN pip install --no-cache-dir "numpy>=2,<3" pillow zstandard boto3

WORKDIR /app
COPY build_pardig_rain.py /app/

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "build_pardig_rain.py"]
